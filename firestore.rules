rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Uses custom claims set by set-roles.js
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isWorker() {
      return isSignedIn() && request.auth.token.role == 'worker';
    }

    // Any authenticated user (worker or owner) can read/write visits
    match /visits/{id} {
      allow read: if isSignedIn();
      allow create: if isWorker() || isOwner();
      allow update, delete: if isOwner();
    }

    // Customers — workers upsert on save, owner can read
    match /customers/{id} {
      allow read, write: if isSignedIn();
    }

    // Rates — workers read (to price washes), owner can edit
    match /rates/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Settings — owner only
    match /settings/{id} {
      allow read, write: if isOwner();
    }

    // Close-day email trigger — any signed-in user can create
    match /emailTasks/{id} {
      allow create: if isSignedIn();
      allow read: if isOwner();
      allow delete: if false;
    }

    // Packages — workers read (to show package picker), owner can edit
    match /packages/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }
  }
}
