rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isWorker() {
      return isSignedIn() && request.auth.token.role == 'worker';
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isStaff() {
      return isWorker() || isOwner();
    }

    function isAllowedImage() {
      return request.resource.contentType in
        ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];
    }

    // Staff-only photo paths — no catch-all read for claim-less accounts.
    match /plates/{plate}/{filename} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.size < 8 * 1024 * 1024
        && isAllowedImage();
    }

    match /fronts/{plate}/{filename} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.size < 8 * 1024 * 1024
        && isAllowedImage();
    }
  }
}
