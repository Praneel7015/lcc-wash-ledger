rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Uses custom claims set by set-roles.js
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isWorker() {
      return isSignedIn() && request.auth.token.role == 'worker';
    }

    // Any authenticated user (worker or owner) can read/write visits
    match /visits/{id} {
      allow read: if isSignedIn();
      allow create: if isWorker() || isOwner();
      // Workers may update paid + paymentMethod only, with consistency rules.
      // All other field changes are owner-only.
      allow update: if isOwner() ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paid', 'paymentMethod']) &&
          (
            (request.resource.data.paid == true &&
              request.resource.data.paymentMethod in ['cash', 'upi']) ||
            (request.resource.data.paid == false &&
              request.resource.data.paymentMethod == null)
          ));
      allow delete: if isOwner();
    }

    // Customers — workers upsert on save, owner can read
    match /customers/{id} {
      allow read, write: if isSignedIn();
    }

    // Rates — workers read (to price washes), owner can edit
    match /rates/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Settings — owner only
    match /settings/{id} {
      allow read, write: if isOwner();
    }

    // Close-day email trigger — any signed-in user can create
    match /emailTasks/{id} {
      allow create: if isSignedIn();
      allow read: if isOwner();
      allow delete: if false;
    }

    // Packages — workers read (to show package picker), owner can edit
    match /packages/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Operator name registry — workers write their own doc, owner reads all
    match /users/{uid} {
      allow read: if isOwner();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
