rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isWorker() {
      return isSignedIn() && request.auth.token.role == 'worker';
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isStaff() {
      return isWorker() || isOwner();
    }

    function isAllowedImage() {
      return request.resource.contentType in
        ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/heic', 'image/heif'];
    }

    // Any authenticated user (worker or owner) can read all photos.
    match /{allPaths=**} {
      allow read: if isSignedIn();
    }

    // Workers AND owners may upload plate photos.
    // `allow write` (create + overwrite) so a retry after a partial upload
    // is not blocked by `create`-only rules.
    match /plates/{plate}/{filename} {
      allow write: if isStaff()
        && request.resource.size < 8 * 1024 * 1024
        && isAllowedImage();
    }

    match /fronts/{plate}/{filename} {
      allow write: if isStaff()
        && request.resource.size < 8 * 1024 * 1024
        && isAllowedImage();
    }
  }
}
